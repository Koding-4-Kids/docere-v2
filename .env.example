# Database
DATABASE_URL=postgresql+asyncpg://docere:docere_dev@localhost:5432/docere

# Redis
REDIS_URL=redis://localhost:6379

# Qdrant
QDRANT_URL=http://localhost:6333

# Anthropic
ANTHROPIC_API_KEY=your-api-key-here

# Embeddings (choose one)
VOYAGE_API_KEY=your-voyage-key-here
# OPENAI_API_KEY=your-openai-key-here

# JWT
JWT_SECRET=change-this-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=1440

# LTI 1.3
LTI_ISSUER=https://canvas.instructure.com
LTI_CLIENT_ID=your-client-id
LTI_DEPLOYMENT_ID=your-deployment-id
LTI_JWKS_URL=https://canvas.instructure.com/api/lti/security/jwks

# Canvas API
CANVAS_BASE_URL=https://your-institution.instructure.com
CANVAS_API_TOKEN=your-canvas-token

# Moodle API
MOODLE_BASE_URL=https://your-moodle-instance.com
MOODLE_API_TOKEN=your-moodle-token

# Environment
ENVIRONMENT=development
DEBUG=true
